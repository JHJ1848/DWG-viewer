{
  "name": "dwg-viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/patch-ole-rasterizer.cjs && tsx server.ts",
    "start": "tsx server.ts",
    "build": "node scripts/patch-ole-rasterizer.cjs && vite build",
    "build:server": "node electron/build-server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "npm run build && npm run build:server && electron-builder --win",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:build": "npm run build && npx cap sync",
    "postinstall": "node scripts/patch-ole-rasterizer.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@google/genai": "^2.4.0",
    "@mlightcad/cad-simple-viewer": "^1.7.6",
    "@mlightcad/data-model": "^1.15.11",
    "@mlightcad/libredwg-converter": "^3.15.11",
    "@mlightcad/libredwg-web": "^0.8.1",
    "@mlightcad/mtext-parser": "^1.5.5",
    "@mlightcad/mtext-renderer": "^0.13.5",
    "@mlightcad/three-renderer": "^1.7.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@velipso/polybool": "^2.0.11",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "panzoom": "^9.4.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
